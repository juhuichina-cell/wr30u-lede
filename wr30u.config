# =====================================================================
# 小米路由器 WR30U  Lean's LEDE 种子配置 (seed config)
# SoC: MediaTek MT7981B (Filogic 820) / NAND UBI
# 用法: cp wr30u.config .config && make defconfig
# defconfig 会自动补齐所有依赖，此处只需勾选"目标设备 + 想要的应用"
# =====================================================================

# ---- 目标平台与设备 ------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u=y

# ---- LuCI 基础 -----------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 主题：argon（Lean 的 luci 源自带 luci-theme-argon，无需引第三方源）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- 网络设置向导（sirpdboy/luci-app-netwizard，零依赖纯 LuCI 应用）
# 说明：iStoreOS 自家 quickstart 官方声明"重构中不可作正式源"，且依赖整套
#       istore 后端服务，故改用这个独立向导
CONFIG_PACKAGE_luci-app-netwizard=y

# ---- Passwall（代理，Openwrt-Passwall 官方源）----------------------
# 只选 luci 壳不会带上任何代理核心：核心藏在 INCLUDE_* 开关后面，
# 透明代理（6.x 内核必须用 nftables 模式）默认更是关闭的，
# 不显式打开会导致"TCP 节点无法启动"。
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# SS 客户端核心（aarch64 上本身就是 default y，显式写死避免被 defconfig 改掉）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
# NaiveProxy：naive 节点必须依赖 naiveproxy 二进制（sing-box / xray 都不支持 naive，
# 源码里由 `if not api.is_finded("naive")` 决定节点是否出现）。
# 已核实 passwall-packages 的 naiveproxy 包并不在本地编译，而是直接下载
# klzgrad 官方预编译包 naiveproxy-v154.0.8037.49-5-openwrt-aarch64_cortex-a53.tar.xz
# （3.3MB），sha256 已比对一致，因此可以安全开启。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y

# ---- 显式移除 SSR（ShadowsocksR）----------------------------------
# INCLUDE_ShadowsocksR_Libev_Client 在 aarch64 上默认是 y，必须显式关掉，
# 否则 ssr-local / ssr-redir 会被自动拉进固件
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-server is not set

# ---- 透明代理所需 nftables 内核模块（显式指定，避免被 depends 拦截）--
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ---- OpenClash（Clash.Meta 客户端，dev 分支，适配 nftables/新内核）--
CONFIG_PACKAGE_luci-app-openclash=y

# ---- KMS 激活服务器（vlmcsd，Lean luci 源自带）---------------------
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# ---- iStore 应用商店（linkease）------------------------------------
CONFIG_PACKAGE_luci-app-store=y

# ---- 显式移除 FTP 服务器插件（Lean 默认会带上 luci-app-vsftpd）-----
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_vsftpd-alt is not set
