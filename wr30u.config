# =====================================================================
# 小米 WR30U (MediaTek MT7981B / Filogic) Lean's LEDE 云端自动编译
#
# 集成功能:
#   - Passwall       (Openwrt-Passwall 官方 feed)
#   - OpenClash      (vernesong dev 分支, 适配 nftables / 新内核)
#   - KMS 服务器      (luci-app-vlmcsd, Lean 源自带)
#   - iStore 应用商店 (linkease/istore, 商店内可一键安装"网络向导")
#
# 触发方式: 推送到 master/main、在 Actions 页面手动 Run workflow、
#           以及每周一 18:00 UTC (北京时间周二 02:00) 自动周更
# =====================================================================
name: Build LEDE for Xiaomi WR30U

on:
  workflow_dispatch:
  push:
    branches:
      - master
      - main
    paths:
      - '.github/workflows/build-wr30u.yml'
      - 'wr30u.config'
  schedule:
    - cron: '0 18 * * 1'   # 不需要自动周更时删除这一段即可

concurrency:
  group: wr30u-build
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  build:
    name: Build firmware
    runs-on: ubuntu-22.04
    timeout-minutes: 300

    steps:
      - name: Checkout config repository
        uses: actions/checkout@v4

      - name: Free disk space
        run: |
          # LEDE 全量编译 + Passwall/OpenClash 的 Go 大件产物容易撑爆 runner 磁盘，
          # 先删掉预装的无用 SDK，可释放 30GB 以上
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
                      /opt/hostedtoolcache /usr/local/share/boost \
                      "$AGENT_TOOLSDIRECTORY" 2>/dev/null || true
          sudo apt-get clean
          df -h /

      - name: Install build dependencies
        run: |
          sudo apt-get update -y
          sudo apt-get install -y build-essential clang flex bison g++ gawk \
            gcc-multilib g++-multilib gettext git libncurses-dev libssl-dev \
            python3-distutils rsync unzip zlib1g-dev file wget cpio

      - name: Clone Lean's LEDE source
        run: |
          # 上游 master 在 2026-10-26 前后把 6.12 内核升到 6.12.114，
          # target/linux/generic/backport-6.12/732-v6.18-wifi-mt76-wed-*.patch 打不上
          # （include/linux/soc/mediatek/mtk_wed.h Hunk #1 FAILED），
          # toolchain/kernel-headers 必然失败 —— run #11 / #12 都是这个原因。
          # 这里锁定到 10-20 那次编译成功所用的上游提交（07cebbc）；
          # 等上游把 patch 修好后，把下面三行换回 git clone --depth 1 即可。
          git init lede
          git -C lede remote add origin https://github.com/coolsnowwolf/lede.git
          ok=0
          for i in 1 2 3; do
            if git -C lede fetch --depth 1 origin 07cebbcf28f61637047645c3fedc829ee9cc3688; then ok=1; break; fi
            echo "fetch lede failed, retry $i ..."; sleep 15
          done
          [ "$ok" = "1" ]
          git -C lede checkout FETCH_HEAD
          git -C lede log -1 --format='pinned lede commit: %H  %ad  %s'

      - name: Add third-party feeds and packages
        working-directory: lede
        run: |
          # ---- Passwall（官方仓库 2026 年已迁至 Openwrt-Passwall 组织）----
          cat >> feeds.conf.default <<'EOF'
          src-git passwall_packages https://github.com/Openwrt-Passwall/openwrt-passwall-packages.git;main
          src-git passwall_luci https://github.com/Openwrt-Passwall/openwrt-passwall.git;main
          EOF

          # Lean 默认 feeds 里带 helloworld（fw876），它也有一个同名 naiveproxy：
          # 那个版本是 Chromium 源码编译，PKG_BUILD_DEPENDS:=gn/host，会覆盖掉
          # passwall-packages 里的预编译版，把 gn 主机工具拉起来编译（必失败，
          # run #13 就是 gn 编译报错）。我们需要的包全在 luci / packages /
          # passwall / 自建 clone 里，直接去掉这个 feed。
          sed -i '/helloworld/d' feeds.conf.default
          cat feeds.conf.default

          mkdir -p package/custom

          # ---- OpenClash（dev 分支）----
          git clone --depth 1 -b dev https://github.com/vernesong/OpenClash.git \
            package/custom/luci-app-openclash

          # ---- iStore 应用商店（含 taskd / luci-lib-taskd / luci-lib-xterm，
          #      istore-ui 前端在 make download 阶段按固定哈希自动下载）----
          git clone --depth 1 https://github.com/linkease/istore.git \
            package/custom/istore

          # ---- 网络设置向导（sirpdboy/luci-app-netwizard，零依赖纯 LuCI 应用）
          # 注意：包本体在仓库的子目录 luci-app-netwizard/ 下，直接把仓库根
          #      clone 进 package/custom 会因为根目录没有 Makefile 而失效，
          #      必须取它的内层目录
          git clone --depth 1 https://github.com/sirpdboy/luci-app-netwizard.git \
            /tmp/netwizard
          cp -r /tmp/netwizard/luci-app-netwizard package/custom/luci-app-netwizard

      - name: Inject build-time defaults (LAN IP + argon theme)
        working-directory: lede
        run: |
          # files/ 目录会被构建系统直接并入固件 rootfs。
          # 用 uci-defaults 脚本在首次启动时生效，恢复出厂设置后同样有效。
          mkdir -p files/etc/uci-defaults
          cat > files/etc/uci-defaults/99-wr30u-defaults <<'EOF'
          #!/bin/sh
          # LAN 网关地址 192.168.20.1（刷完机浏览器需改用该地址访问）
          uci set network.lan.ipaddr='192.168.20.1'
          uci set network.lan.netmask='255.255.255.0'
          uci commit network
          # 默认主题切到 argon
          uci set luci.main.mediaurlbase='/luci-static/argon'
          uci commit luci
          exit 0
          EOF
          chmod +x files/etc/uci-defaults/99-wr30u-defaults
          ls -l files/etc/uci-defaults/

      - name: Update and install feeds
        working-directory: lede
        run: |
          set -e
          ./scripts/feeds clean
          ok=0
          for i in 1 2 3; do
            if ./scripts/feeds update -a; then ok=1; break; fi
            echo "feeds update failed, retry $i ..."; sleep 15
          done
          [ "$ok" = "1" ]
          ./scripts/feeds install -a

      - name: Load seed config and run defconfig
        working-directory: lede
        run: |
          cp "$GITHUB_WORKSPACE/wr30u.config" .config
          make defconfig

      - name: Verify target device and required apps are selected
        working-directory: lede
        run: |
          fail=0
          for sym in \
            CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u=y \
            CONFIG_PACKAGE_luci=y \
            CONFIG_PACKAGE_luci-theme-argon=y \
            CONFIG_PACKAGE_luci-app-argon-config=y \
            CONFIG_PACKAGE_luci-app-netwizard=y \
            CONFIG_PACKAGE_luci-app-passwall=y \
            CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y \
            CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y \
            CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y \
            CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y \
            CONFIG_PACKAGE_naiveproxy=y \
            CONFIG_PACKAGE_luci-app-openclash=y \
            CONFIG_PACKAGE_luci-app-vlmcsd=y \
            CONFIG_PACKAGE_luci-app-store=y
          do
            if grep -qx "$sym" .config; then
              echo "OK  $sym"
            else
              echo "::error::required symbol missing after defconfig: $sym"
              fail=1
            fi
          done

          # FTP 插件只告警、不判失败：万一它被某个依赖强制拉起，
          # 也先把产物编出来，凭日志里的告警确认后再处理
          if grep -qx 'CONFIG_PACKAGE_luci-app-vsftpd=y' .config; then
            echo "::warning::luci-app-vsftpd is still selected, FTP plugin not removed"
          else
            echo "OK  luci-app-vsftpd removed"
          fi

          echo '----- platform info -----'
          grep -E 'CONFIG_TARGET_(ARCH|SUBTARGET|PROFILE)|CONFIG_USE_APK|CONFIG_TARGET_ROOTFS_SQUASHFS' .config || true
          echo '----- selected luci i18n translations -----'
          grep -E '^CONFIG_PACKAGE_luci-i18n-' .config || true

          # nftables 透明代理所需的三个内核模块：缺失则 TCP 透明代理不可能工作。
          # 只告警不判失败，先保证产物能出来
          for sym in kmod-nft-tproxy kmod-nft-socket kmod-nft-nat; do
            if grep -qx "CONFIG_PACKAGE_$sym=y" .config; then
              echo "OK  $sym"
            else
              echo "::warning::missing $sym, nftables transparent proxy may not work"
            fi
          done

          # SSR 是否真的移除（任何以 CONFIG_PACKAGE_shadowsocksr / ..._INCLUDE_ShadowsocksR 开头
          # 的启用项都算没移除干净）
          if grep -qE '^CONFIG_PACKAGE_(shadowsocksr|luci-app-passwall_INCLUDE_ShadowsocksR)' .config; then
            echo "::warning::SSR is still selected:"
            grep -E '^CONFIG_PACKAGE_(shadowsocksr|luci-app-passwall_INCLUDE_ShadowsocksR)' .config
          else
            echo "OK  SSR removed"
          fi

          # helloworld 的源码版 naiveproxy 一旦混进来，就会拉 gn/host 并把编译拖死
          if grep -qx 'CONFIG_PACKAGE_gn=y' .config; then
            echo "::error::host package gn is selected - helloworld naiveproxy leaked in"
            fail=1
          else
            echo "OK  no gn host package"
          fi
          exit $fail

      - name: Download sources (with retries)
        working-directory: lede
        run: |
          ok=0
          for i in 1 2 3 4 5; do
            if make download -j8; then ok=1; break; fi
            echo "make download failed, retry $i ..."; sleep 20
          done
          if [ "$ok" != "1" ]; then make download -j1 V=s; exit 1; fi

      - name: Compile firmware
        working-directory: lede
        run: |
          log=/tmp/build.log

          # 失败时把关键错误行写成 annotation：check-run 的 annotation 匿名可读，
          # 而 job log 需要登录才能拉取，这样失败原因能直接被定位
          report() {
            echo "::error::$1 compile failed, key lines from build log:"
            grep -nE '(Error [0-9]+|: \*\*\*|error:|ERROR:|fatal error|No rule to make|cannot find|undefined reference|No such file)' "$log" | tail -n 5 | while IFS= read -r l; do
              l="${l//%/%25}"; l="${l//$'\r'/}"
              echo "::error::$l"
            done
            tail -n 5 "$log" | while IFS= read -r l; do
              l="${l//%/%25}"; l="${l//$'\r'/}"
              echo "::error::$l"
            done
          }

          if make -j"$(nproc)" >"$log" 2>&1; then
            echo 'parallel build OK'
          else
            report 'parallel build'
            echo 'parallel build failed, retry serial with V=s'
            if make -j1 V=s >>"$log" 2>&1; then
              echo 'serial retry OK'
            else
              report 'serial retry'
              exit 1
            fi
          fi

      - name: Collect firmware files
        working-directory: lede
        run: |
          out="$GITHUB_WORKSPACE/firmware"
          mkdir -p "$out"
          d=bin/targets/mediatek/filogic

          # 先打印源目录真实内容与官方校验清单，便于确认镜像的确切文件名
          ls -la "$d"
          cat "$d/sha256sums" || true

          cp .config "$out/wr30u-expanded.config"
          # 按设备名全量拷贝：该设备镜像是 IMAGE/sysupgrade.bin（内容为 tar），
          # 不能只按 *-sysupgrade.tar 匹配，否则会漏掉
          cp -v "$d"/*xiaomi_mi-router-wr30u* "$out"/ 2>/dev/null || true
          cp -v "$d"/sha256sums "$out"/ 2>/dev/null || true
          cp -v "$d"/*.buildinfo "$out"/ 2>/dev/null || true
          cp -v "$d"/*.manifest "$out"/ 2>/dev/null || true
          cp -v "$d"/profiles.json "$out"/ 2>/dev/null || true

          echo '----- collected files -----'
          ls -lh "$out"
          echo '---------------------------'
          find "$out" -name '*sysupgrade*' -printf '%f\n'

          # 直接从镜像 manifest 打印代理相关包，作为"包里到底有什么"的硬证据
          echo '----- proxy related packages in image -----'
          for m in "$out"/*.manifest; do
            [ -f "$m" ] || continue
            grep -iE 'passwall|xray|sing-box|naive|shadowsocksr|ssr|v2ray|hysteria|kmod-nft-tproxy|kmod-nft-socket|kmod-nft-nat|dnsmasq' "$m" || true
          done
          echo '------------------------------------------'
          test -n "$(find "$out" -name '*sysupgrade*')"

      - name: Upload firmware artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: wr30u-lean-lede-${{ github.run_number }}
          path: firmware/
          retention-days: 30
          if-no-files-found: warn
          compression-level: 0
