# =====================================================================
# 小米路由器 WR30U  Lean's LEDE 种子配置 (seed config)
# SoC: MediaTek MT7981B (Filogic 820) / NAND UBI
# 用法: cp wr30u.config .config && make defconfig
# defconfig 会自动补齐所有依赖，此处只需勾选"目标设备 + 想要的应用"
# =====================================================================

# ---- 目标平台与设备 ------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u=y

# ---- LuCI 基础 -----------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- Passwall（代理，Openwrt-Passwall 官方源，含 Xray/Sing-box 等核心）
CONFIG_PACKAGE_luci-app-passwall=y

# ---- OpenClash（Clash.Meta 客户端，dev 分支，适配 nftables/新内核）--
CONFIG_PACKAGE_luci-app-openclash=y

# ---- KMS 激活服务器（vlmcsd，Lean luci 源自带）---------------------
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# ---- iStore 应用商店（linkease，商店内含"网络向导"可一键安装）------
CONFIG_PACKAGE_luci-app-store=y
